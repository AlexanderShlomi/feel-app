# לפיתוח מקומי: העתק ל-.env והשלם ערכים.
# ב-Vercel: Project → Settings → Environment Variables (אותם שמות).

PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_from_supabase_dashboard

# כתובת האתר המלאה לפריוויו בשיתוף (og:image / og:url). חובה מומלץ בפרודקשן מאחורי reverse proxy.
# לדוגמה: https://www.feel.example
PUBLIC_SITE_URL=

# ───────── מדידה ופרסום (אופציונלי) ─────────
# כל מזהה אופציונלי: פלטפורמה נטענת רק אם המזהה שלה הוגדר, ורק לאחר הסכמת המשתמש
# (Consent Mode v2, Opt-in). השאר ריק כדי לכבות לחלוטין.
#
# Google Analytics 4 — קטגוריית "אנליטיקה"
PUBLIC_GA4_MEASUREMENT_ID=
# Meta (Facebook/Instagram) Pixel — קטגוריית "פרסום"/"חברתי"
PUBLIC_META_PIXEL_ID=
# TikTok Pixel — קטגוריית "פרסום"/"חברתי"
PUBLIC_TIKTOK_PIXEL_ID=
# Google Ads conversion ID (AW-XXXXXXXXX) — קטגוריית "פרסום"
PUBLIC_GOOGLE_ADS_ID=
# Google Tag Manager container (GTM-XXXXXXX). אם מוגדר — נטען מיכל GTM יחיד שמנהל את
# כל התגיות, במקום הזרקה ישירה של כל פלטפורמה.
PUBLIC_GTM_CONTAINER_ID=
